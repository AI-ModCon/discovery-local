# Public images for this stack, so `docker compose pull` works from a clone.
# Compose reads this file automatically; override any line in your shell.
#
# These are multi-architecture manifest lists covering linux/amd64 and
# linux/arm64, so the pull resolves to match your machine. Intel, AMD, Apple
# Silicon and Windows via WSL2 all work.
GENESIS_API_IMAGE=ghcr.io/ai-modcon/genesis-discovery-api:latest
GENESIS_UI_IMAGE=ghcr.io/ai-modcon/genesis-discovery-ui:latest
REGISTRY_IMAGE=ghcr.io/ai-modcon/xcard-registry:latest
